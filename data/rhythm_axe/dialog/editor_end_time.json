{
  "type": "minecraft:multi_action",
  "title": {
    "text": "编辑结束时间"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "输入结束时间（刻）；输入 -1 表示未定义（当前值见聊天栏面板）"
      }
    }
  ],
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "end_time_value",
      "width": 150,
      "label": {
        "text": "结束时间（刻）"
      },
      "max_length": 16
    }
  ],
    "exit_action": {
    "label": {
      "text": "取消"
    },
    "action": {
      "type": "run_command",
      "command": "/function rhythm_axe:editor/menu/dialog/dialog_cancel"
    }
  },

  "can_close_with_escape": true,
  "pause": false,
  "actions": [
    {
      "label": {
        "text": "确认"
      },
      "action": {
        "type": "dynamic/run_command",
        "template": "/function rhythm_axe:editor/menu/dialog/dialog_submit_end_time {\"value\":\"$(end_time_value)\"}"
      }
    }
  ]
}
