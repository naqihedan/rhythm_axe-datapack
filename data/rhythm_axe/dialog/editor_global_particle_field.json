{
  "type": "minecraft:multi_action",
  "title": {
    "text": "编辑全局击打视效"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "输入该情况的粒子/效果 id（如 minecraft:note particle；空=无；含引号用 \\\" 转义）"
      }
    }
  ],
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "value",
      "width": 300,
      "label": {
        "text": "值"
      },
      "max_length": 200
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "exit_action": {
    "label": {
      "text": "取消"
    },
    "action": {
      "type": "run_command",
      "command": "/function rhythm_axe:editor/menu/note/global/global_particle_detail"
    }
  },
  "actions": [
    {
      "label": {
        "text": "确认"
      },
      "action": {
        "type": "dynamic/run_command",
        "template": "/function rhythm_axe:editor/menu/note/dialog/dialog_submit_global_particle_field {\"value\":\"$(value)\",\"particle_group\":\"$(particle_group)\",\"particle_case\":\"$(particle_case)\"}"
      }
    }
  ]
}
