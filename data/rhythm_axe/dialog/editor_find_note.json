{
  "type": "minecraft:multi_action",
  "title": {
    "text": "查找音符"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "按条件筛选音符并设为选中。所有条件之间为「且」。"
      }
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "下拉选「全部/不限」、文本留空 = 该条件忽略；范围可只填一端。"
      }
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "不勾「查找选区内」：替换当前选中（命中多少选多少，列表翻页查看）；勾上：在当前选区内筛选（保留命中、移出不命中）。"
      }
    }
  ],
  "inputs": [
    {
      "type": "minecraft:single_option",
      "key": "note_type",
      "width": 150,
      "label": { "text": "音符类型" },
      "options": [
        { "id": "all", "display": { "text": "全部" }, "initial": true },
        { "id": "0", "display": { "text": "音符盒" } },
        { "id": "1", "display": { "text": "木板" } },
        { "id": "2", "display": { "text": "唱片机" } },
        { "id": "3", "display": { "text": "混凝土" } },
        { "id": "4", "display": { "text": "染色玻璃" } }
      ]
    },
    {
      "type": "minecraft:single_option",
      "key": "note_color",
      "width": 150,
      "label": { "text": "颜色" },
      "options": [
        { "id": "all", "display": { "text": "全部" }, "initial": true },
        { "id": "0", "display": { "text": "未设置" } },
        { "id": "1", "display": { "text": "白" } },
        { "id": "2", "display": { "text": "灰" } },
        { "id": "3", "display": { "text": "淡灰" } },
        { "id": "4", "display": { "text": "黑" } },
        { "id": "5", "display": { "text": "棕" } },
        { "id": "6", "display": { "text": "红" } },
        { "id": "7", "display": { "text": "橙" } },
        { "id": "8", "display": { "text": "黄" } },
        { "id": "9", "display": { "text": "黄绿" } },
        { "id": "10", "display": { "text": "绿" } },
        { "id": "11", "display": { "text": "青" } },
        { "id": "12", "display": { "text": "淡蓝" } },
        { "id": "13", "display": { "text": "蓝" } },
        { "id": "14", "display": { "text": "紫" } },
        { "id": "15", "display": { "text": "品红" } },
        { "id": "16", "display": { "text": "粉" } }
      ]
    },
    {
      "type": "minecraft:text",
      "key": "time_from",
      "width": 90,
      "label": { "text": "时间从（刻）" },
      "max_length": 10
