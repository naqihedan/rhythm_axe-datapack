  "can_close_with_escape": true,
  "pause": false,
  "exit_action": {
    "label": {
      "text": "取消"
    },
    "action": {
      "type": "run_command",
      "command": "/function rhythm_axe:editor/menu/dialog/dialog_cancel"
    }
  },
  "actions": [
    {
      "label": {
        "text": "查找并选中"
      },
      "action": {
        "type": "dynamic/run_command",
        "template": "function rhythm_axe:editor/menu/find/dialog_submit_find_note {\"type\":\"$(note_type)\",\"color\":\"$(note_color)\",\"tfrom\":\"$(time_from)\",\"tto\":\"$(time_to)\",\"insel\":\"$(in_selection)\",\"idfrom\":\"$(id_from)\",\"idto\":\"$(id_to)\",\"szfrom\":\"$(size_from)\",\"szto\":\"$(size_to)\",\"dfrom\":\"$(dur_from)\",\"dto\":\"$(dur_to)\",\"dnfrom\":\"$(density_from)\",\"dnto\":\"$(density_to)\",\"lifrom\":\"$(life_from)\",\"lito\":\"$(life_to)\",\"hvfrom\":\"$(hev_from)\",\"hvto\":\"$(hev_to)\",\"easing\":\"$(easing)\",\"power\":\"$(power)\",\"hs\":\"$(hitsound)\",\"pt\":\"$(particles)\",\"igsp\":\"$(ignore_speed)\",\"fwp\":\"$(following)\",\"px\":\"$(pos_x)\",\"py\":\"$(pos_y)\",\"pz\":\"$(pos_z)\",\"sx\":\"$(start_x)\",\"sy\":\"$(start_y)\",\"sz\":\"$(start_z)\"}"
      }
    },
    {
      "label": {
        "text": "选中同刻"
      },
      "action": {
        "type": "run_command",
        "command": "function rhythm_axe:editor/menu/find/dialog_submit_find_same_time"
      }
    }
  ]
}
