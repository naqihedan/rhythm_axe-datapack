    {
      "type": "minecraft:text",
      "key": "time_to",
      "width": 90,
      "label": { "text": "时间到（刻）" },
      "max_length": 10
    },
    {
      "type": "minecraft:boolean",
      "key": "in_selection",
      "label": { "text": "查找选区内（勾上 = 在当前选区内筛选，保留命中、移出不命中；选区无数量上限）" },
      "on_true": "1",
      "on_false": "0"
    },
    {
      "type": "minecraft:text",
      "key": "id_from",
