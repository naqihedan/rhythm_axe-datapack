      "options": [
        { "id": "all", "display": { "text": "不限" }, "initial": true },
        { "id": "0", "display": { "text": "0（跟随全局）" } },
        { "id": "1", "display": { "text": "1" } },
        { "id": "2", "display": { "text": "2" } },
        { "id": "3", "display": { "text": "3" } },
