{
  "type": "minecraft:multi_action",
  "title": {
    "text": "自定义旋转角度"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "输入旋转角度（单位：度，可带小数与负号，如 37.5 / -12）"
      }
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "按当前开启的 [X][Y][Z] 轴（作旋转轴）绕锚点旋转；[S] 开则起始位置跟着转。正数 = 逆时针（右手定则），负数 = 顺时针。一次快照，可撤销。"
      }
    }
  ],
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "angle",
      "width": 150,
      "label": {
        "text": "角度（度）"
      },
      "max_length": 12
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "exit_action": {
    "label": {
      "text": "取消"
    },
    "action": {
      "type": "run_command",
      "command": "/function rhythm_axe:editor/menu/dialog/dialog_cancel"
    }
  },
  "actions": [
    {
      "label": {
        "text": "确认"
      },
      "action": {
        "type": "dynamic/run_command",
        "template": "function rhythm_axe:editor/menu/note/dialog/dialog_submit_rotate_angle {\"value\":\"$(angle)\"}"
      }
    }
  ]
}
