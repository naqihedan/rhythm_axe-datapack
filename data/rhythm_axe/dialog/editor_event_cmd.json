{
  "type": "minecraft:multi_action",
  "title": {
    "text": "编辑事件指令"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "输入指令（含引号用 \\\" 转义；超长/复杂指令建议写 function 文件）"
      }
    }
  ],
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "cmd_value",
      "width": 300,
      "label": {
        "text": "指令"
      },
      "max_length": 100
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "exit_action": {
    "label": {
      "text": "取消"
    },
    "action": {
      "type": "run_command",
      "command": "/function rhythm_axe:editor/menu/dialog/dialog_cancel"
    }
  },
  "actions": [
    {
      "label": {
        "text": "确认"
      },
      "action": {
        "type": "dynamic/run_command",
        "template": "function rhythm_axe:editor/menu/event/dialog/dialog_submit_event_cmd {\"value\":\"$(cmd_value)\"}"
      }
    }
  ]
}
