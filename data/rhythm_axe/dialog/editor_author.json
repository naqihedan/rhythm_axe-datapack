{
  "type": "minecraft:multi_action",
  "title": {
    "text": "编辑作者"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "输入新作者（当前值见聊天栏面板）"
      }
    }
  ],
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "author_value",
      "width": 200,
      "label": {
        "text": "新作者"
      },
      "max_length": 64
    }
  ],
    "exit_action": {
    "label": {
      "text": "取消"
    },
    "action": {
      "type": "run_command",
      "command": "/function rhythm_axe:editor/menu/dialog/dialog_cancel"
    }
  },

  "can_close_with_escape": true,
  "pause": false,
  "actions": [
    {
      "label": {
        "text": "确认"
      },
      "action": {
        "type": "dynamic/run_command",
        "template": "function rhythm_axe:editor/menu/dialog/dialog_submit_author {\"value\":\"$(author_value)\"}"
      }
    }
  ]
}
