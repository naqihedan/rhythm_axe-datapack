{
  "type": "minecraft:multi_action",
  "title": {
    "text": "编辑标题"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "可直接输入纯文本（如 新手教程，支持空格）；需要颜色等样式时输入 JSON 文本组件：对象 {\\\"text\":\\\"标题\",\\\"color\":\\\"red\\\"}、列表 [{\\\"text\\\":\\\"A\\\"},{\\\"text\\\":\\\"B\"\\}] 或带引号字符串 \\\"新手教程\\\""
      }
    }
  ],
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "title_value",
      "width": 300,
      "label": {
        "text": "新标题"
      },
      "max_length": 128
    }
  ],
    "exit_action": {
    "label": {
      "text": "取消"
    },
    "action": {
      "type": "run_command",
      "command": "/function rhythm_axe:editor/menu/dialog/dialog_cancel"
    }
  },

  "can_close_with_escape": true,
  "pause": false,
  "actions": [
    {
      "label": {
        "text": "确认"
      },
      "action": {
        "type": "dynamic/run_command",
        "template": "function rhythm_axe:editor/menu/dialog/dialog_submit_title {\"value\":'$(title_value)'}"
      }
    }
  ]
}
