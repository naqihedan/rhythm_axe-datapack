{
  "type": "minecraft:multi_action",
  "title": {
    "text": "插值填充：每段个数"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "每对相邻选中音符之间插入几个新音符（1~99）"
      }
    }
  ],
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "value",
      "width": 100,
      "label": { "text": "个数" },
      "max_length": 8
    }
  ],
  "can_close_with_escape": true,
  "pause": false,
  "exit_action": {
    "label": { "text": "取消" },
    "action": {
      "type": "run_command",
      "command": "/function rhythm_axe:editor/menu/dialog/dialog_cancel"
    }
  },
  "actions": [
    {
      "label": { "text": "确认" },
      "action": {
        "type": "dynamic/run_command",
        "template": "function rhythm_axe:editor/menu/dialog/dialog_submit_df_count {\"value\":\"$(value)\"}"
      }
    }
  ]
}
