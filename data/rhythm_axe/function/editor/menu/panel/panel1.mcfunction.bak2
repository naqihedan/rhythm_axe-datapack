# 面板 1：主菜单。新编码：值 = 行号×100 + 行内按钮号(01..)。
# 行1: 101 编辑谱面信息 / 102 时间点列表 / 103 事件列表
# 行2: 201 活跃音符列表 / 202 已选音符列表
# 行3: 301 音符工具 / 302 时间轴控件
# 行4: 401 撤销 / 402 重做 / 403 查找
# 行5: 501 保存 / 502 退出 / 503 另存 / 504 删除谱面 / 505 回收站
# 行6: 601 节拍器
# 行7: 701/702 流速减/加；703/704/705/706 流速设 2/4/8/16
# 注：20..29 时间控件由 consume 顶层统一处理(任意面板)；8/9 撤销重做、903 亦顶层。value 1=返回主菜单(供其它面板/刷新用)。
# main.mcfunction 设 current_panel=1。
# 入口白名单守卫
execute unless score #click_value editor matches 1 unless score #click_value editor matches 100..799 run function rhythm_axe:editor/menu/wrong_panel
execute unless score #click_value editor matches 1 unless score #click_value editor matches 100..799 run return fail

execute if score #click_value editor matches 1 run function rhythm_axe:editor/menu/main
# 行1：打开设置/列表
execute if score #click_value editor matches 101 run function rhythm_axe:editor/menu/map/panel/map_panel_open
execute if score #click_value editor matches 102 run function rhythm_axe:editor/menu/timing/list/timing_list_open
execute if score #click_value editor matches 103 run function rhythm_axe:editor/menu/event/list/event_list_open
# 行2：音符列表
execute if score #click_value editor matches 201 run function rhythm_axe:editor/menu/note/list/note_list_open
execute if score #click_value editor matches 202 run function rhythm_axe:editor/menu/note/selected/sel_note_list_open
# 行3：工具
execute if score #click_value editor matches 301 run function rhythm_axe:editor/tool/give_note_tool
execute if score #click_value editor matches 302 run function rhythm_axe:editor/tool/give_timeline_tool
# 行4：撤销/重做（回主菜单）/查找
execute if score #click_value editor matches 401 run function rhythm_axe:editor/file/undo
execute if score #click_value editor matches 401 run data modify storage rhythm_axe:maps.editor current_panel set value 1
execute if score #click_value editor matches 401 run function rhythm_axe:editor/menu/resume
execute if score #click_value editor matches 402 run function rhythm_axe:editor/file/redo
execute if score #click_value editor matches 402 run data modify storage rhythm_axe:maps.editor current_panel set value 1
execute if score #click_value editor matches 402 run function rhythm_axe:editor/menu/resume
execute if score #click_value editor matches 403 run function rhythm_axe:editor/menu/find/find_open
# 行5：保存/退出/另存/删除/回收站
execute if score #click_value editor matches 501 run function rhythm_axe:editor/menu/save_now
execute if score #click_value editor matches 502 run function rhythm_axe:editor/exit
execute if score #click_value editor matches 503 run function rhythm_axe:editor/menu/save_as/save_as
execute if score #click_value editor matches 504 run function rhythm_axe:editor/menu/map/panel/map_delete_confirm
execute if score #click_value editor matches 505 run function rhythm_axe:editor/menu/trash/trash_panel_open
# 行6：节拍器
execute if score #click_value editor matches 601 run function rhythm_axe:editor/menu/metronome_toggle

# —— 行7：音符流速（701 降低 / 702 提高，下界 1；703..706 直接设值）——
execute if score #click_value editor matches 701 run scoreboard players remove note_speed options 1
execute if score #click_value editor matches 702 run scoreboard players add note_speed options 1
execute if score #click_value editor matches 701..702 if score note_speed options matches ..0 run scoreboard players set note_speed options 1
execute if score #click_value editor matches 701..702 run function rhythm_axe:editor/refresh
execute if score #click_value editor matches 701..702 run function rhythm_axe:editor/menu/main
execute if score #click_value editor matches 703 run scoreboard players set note_speed options 2
execute if score #click_value editor matches 704 run scoreboard players set note_speed options 4
execute if score #click_value editor matches 705 run scoreboard players set note_speed options 8
execute if score #click_value editor matches 706 run scoreboard players set note_speed options 16
execute if score #click_value editor matches 703..706 run function rhythm_axe:editor/refresh
execute if score #click_value editor matches 703..706 run function rhythm_axe:editor/menu/main
