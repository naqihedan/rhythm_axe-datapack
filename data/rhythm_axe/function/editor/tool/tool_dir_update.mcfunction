#arg:slot
# @s = 玩家；$(slot) = 目标槽位。方向工具（editor_tool_fwd/editor_tool_bwd/editor_tool_model）按蹲下状态换名字：
# 前进工具：站立=前进、蹲下=快退；快退工具：站立=快退、蹲下=快进。状态由 tool_regular_apply 统一写入 #tool_sneak。
# 仅当该槽 editor_tool_state 与目标状态不符时才重写（避免每 tick 无谓重写）。
# 前置：由 tool_regular_slot 确认该槽是编辑工具。

# 前进工具（站立=前进、蹲下=快退）
$execute if score #tool_sneak editor matches 0 unless items entity @s $(slot) *[custom_data~{editor_tool_state:0}] if items entity @s $(slot) *[custom_data~{editor_tool_timeline_next_tick:true}] run function rhythm_axe:editor/tool/tool_dir_write {slot:"$(slot)",marker:"editor_tool_timeline_next_tick",model:"minecraft:gold_ingot",fwd:"前进一刻",bwd:"快退一刻",shown:"前进一刻",hint:"蹲下以快退",state:0}
$execute if score #tool_sneak editor matches 1 unless items entity @s $(slot) *[custom_data~{editor_tool_state:1}] if items entity @s $(slot) *[custom_data~{editor_tool_timeline_next_tick:true}] run function rhythm_axe:editor/tool/tool_dir_write {slot:"$(slot)",marker:"editor_tool_timeline_next_tick",model:"minecraft:gold_ingot",fwd:"前进一刻",bwd:"快退一刻",shown:"快退一刻",hint:"站立以快进",state:1}
