$execute if score #tool_sneak editor matches 1 unless items entity @s $(slot) *[custom_data~{editor_tool_state:1}] if items entity @s $(slot) *[custom_data~{editor_tool_timeline_next_beat:true}] run function rhythm_axe:editor/tool/tool_dir_write {slot:"$(slot)",marker:"editor_tool_timeline_next_beat",model:"minecraft:iron_ingot",fwd:"前进一拍",bwd:"快退一拍",shown:"快退一拍",hint:"站立以快进",state:1}
$execute if score #tool_sneak editor matches 0 unless items entity @s $(slot) *[custom_data~{editor_tool_state:0}] if items entity @s $(slot) *[custom_data~{editor_tool_timeline_next_bar:true}] run function rhythm_axe:editor/tool/tool_dir_write {slot:"$(slot)",marker:"editor_tool_timeline_next_bar",model:"minecraft:copper_ingot",fwd:"前进一小节",bwd:"快退一小节",shown:"前进一小节",hint:"蹲下以快退",state:0}
