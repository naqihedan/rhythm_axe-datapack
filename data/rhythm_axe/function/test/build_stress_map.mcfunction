# ============ Stress chart: 5 lanes side by side (2026-08-08 rewrite) ============
# Five note types spread across x=0.5~4.5 (type0 noteblock / 1 plank / 2 jukebox / 3 concrete / 4 glass, one lane each)
# Four segments (120 ticks each, bpm 240):
#   seg1 0~119   linear easing1/1  interval 5 tick (1 per tick, light)
#   seg2 120~239 nonlinear easing3/3 interval 5 tick (1 per tick, light)
#   seg3 240~359 linear easing1/1  interval 1 tick (5 per tick, heavy)
#   seg4 360~479 nonlinear easing3/3 interval 1 tick (5 per tick, heavy)
# note_base_life=32 -> seg3/4 steady-state ~160 concurrent notes + glass center markers + concrete zone markers
# concrete duration=8 density=8; glass duration=4 (pass-through after judgement)
# Run: function rhythm_axe:play/start_of_game/start_of_game {mapid:\
# Watch mspt: F3 / /tick rate / /debug mspt (target: high-BPM chart mspt < 30)

execute if data storage rhythm_axe:maps.stress timing_points run data remove storage rhythm_axe:maps.stress timing_points
execute if data storage rhythm_axe:maps.stress notes run data remove storage rhythm_axe:maps.stress notes
execute if data storage rhythm_axe:maps.stress events run data remove storage rhythm_axe:maps.stress events
data merge storage rhythm_axe:maps.stress {id:"stress",title:'{"text":"Stress Test"}',artist:"test",music:"rhythm_axe:rhythm_axe.audio",health:1000,player_count:1,end_time:540,teleport:0b}

data modify storage rhythm_axe:maps.stress timing_points append value {time:0,bpm:150,bpb:4,tpb:8,judgement_scale:1}

# Event: at time 0, let @p run tick sprint 240 (fast-forward to heavy seg3/seg4, skip light seg1/seg2 for mspt stress)
#   NOTE: tick sprint needs permission level 2 (player must have OP/cheats); used to jump straight to the heavy section
# data modify storage rhythm_axe:maps.stress events append value {time:0,commands:["execute as @p run tick sprint 540"]}

